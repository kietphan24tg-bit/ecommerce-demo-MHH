# Application
app_name=ecommerce
app_env=development
debug=false
api_prefix=api/v1

# Database (required in production)
database_url=postgresql+psycopg://user:password@localhost:5432/ecommerce

# JWT (required)
jwt_secret_key=change-me-to-a-long-random-secret
jwt_algorithm=HS256
jwt_issuer=ecommerce-api
jwt_expires_in=15
jwt_refresh_expires_in=7

# CORS
allowed_cors_origins=http://localhost:5173

# Mail (optional)
mail_enabled=false
mail_from=noreply@example.com
mail_from_name=Ecommerce
smtp_host=
smtp_port=587
smtp_username=
smtp_password=
smtp_use_tls=true
smtp_use_ssl=false
smtp_timeout_seconds=10

# Password reset
password_reset_code_expires_in=10
password_reset_token_expires_in=15
password_reset_code_length=6

# Auth cookies
trusted_proxy=false
auth_cross_site=false
# refresh_cookie_secure=
# refresh_cookie_samesite=lax

# Social auth (optional)
google_client_id=
google_client_secret=
google_redirect_uri=http://localhost:5173/auth/google/callback
facebook_client_id=
facebook_client_secret=
facebook_redirect_uri=http://localhost:5173/auth/facebook/callback

# Redis (required when rate limiting is enabled in production)
redis_url=redis://localhost:6379/0
rate_limit_enabled=true

# Global rate limits
rate_limit_global_requests=120
rate_limit_global_window_seconds=60

# Login rate limits
rate_limit_login_ip_requests=10
rate_limit_login_ip_window_seconds=60
rate_limit_login_identifier_requests=5
rate_limit_login_identifier_window_seconds=900

# Register rate limits
rate_limit_register_ip_requests=5
rate_limit_register_ip_window_seconds=3600
rate_limit_register_email_requests=3
rate_limit_register_email_window_seconds=3600

# Forgot-password rate limits
rate_limit_forgot_request_ip_requests=10
rate_limit_forgot_request_ip_window_seconds=3600
rate_limit_forgot_request_email_requests=3
rate_limit_forgot_request_email_window_seconds=3600
rate_limit_forgot_request_cooldown_seconds=60
rate_limit_forgot_verify_ip_requests=20
rate_limit_forgot_verify_ip_window_seconds=3600
rate_limit_forgot_verify_email_requests=5
rate_limit_forgot_verify_email_window_seconds=900
rate_limit_forgot_verify_max_attempts=5
rate_limit_forgot_verify_attempt_window_seconds=900
rate_limit_forgot_reset_email_requests=5
rate_limit_forgot_reset_email_window_seconds=3600

# Refresh rate limits
rate_limit_refresh_ip_requests=30
rate_limit_refresh_ip_window_seconds=600

# Container runtime
PORT=4000
